rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    // Public read-only collections
    match /services/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /serviceDetails/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /projectImages/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /reviews/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // contactSubmissions: server only
    match /contactSubmissions/{docId} {
      allow read, write: if false;
    }
    // bookings: server only (Admin SDK bypasses these rules)
    match /bookings/{docId} {
      allow read, write: if false;
    }
    // processedWebhookEvents: server-only idempotency ledger
    match /processedWebhookEvents/{docId} {
      allow read, write: if false;
    }
    // shopItems: public read, server-only write
    match /shopItems/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // orders: server-only read/write
    match /orders/{docId} {
      allow read, write: if false;
    }
    // back-office + RMA + abandoned carts: server-only (Admin SDK bypasses rules)
    match /stockAudit/{docId}     { allow read, write: if false; }
    match /purchaseOrders/{docId} { allow read, write: if false; }
    match /rmaRequests/{docId}    { allow read, write: if false; }
    match /abandonedCarts/{docId} { allow read, write: if false; }
  }
}
